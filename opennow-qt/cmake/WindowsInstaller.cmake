set(CPACK_PACKAGE_VERSION "${OPENNOW_NUMERIC_VERSION}")
set(CPACK_WIX_ARCHITECTURE "${OPENNOW_PACKAGE_ARCH}")
set(CPACK_STRIP_FILES FALSE)
set(CPACK_GENERATOR "WIX;ZIP")
set(CPACK_WIX_UPGRADE_GUID "6E81F7AE-B19D-4E87-A94A-2B2F01EBF762")

if(OPENNOW_BUILD_VERSION MATCHES "-(nightly|supporter)\\.([0-9]+)\\.([0-9]+)$")
    set(OPENNOW_MSI_CHANNEL "${CMAKE_MATCH_1}")
    set(OPENNOW_MSI_RUN "${CMAKE_MATCH_2}")
    set(OPENNOW_MSI_ATTEMPT "${CMAKE_MATCH_3}")
    if(OPENNOW_MSI_RUN GREATER 65535 OR OPENNOW_MSI_ATTEMPT GREATER 65535)
        message(FATAL_ERROR "MSI run and attempt must each be in 1..65535")
    endif()
    math(EXPR OPENNOW_MSI_MAJOR "${OPENNOW_MSI_RUN} / 256")
    math(EXPR OPENNOW_MSI_MINOR "${OPENNOW_MSI_RUN} % 256")
    set(CPACK_PACKAGE_VERSION "${OPENNOW_MSI_MAJOR}.${OPENNOW_MSI_MINOR}.${OPENNOW_MSI_ATTEMPT}")
    if(OPENNOW_MSI_CHANNEL STREQUAL "nightly")
        set(CPACK_PACKAGE_NAME "OpenNOW Nightly")
        set(CPACK_WIX_UPGRADE_GUID "9661F4F8-656C-4B64-9035-01B04F4822B1")
    else()
        set(CPACK_PACKAGE_NAME "OpenNOW Supporter")
        set(CPACK_WIX_UPGRADE_GUID "B3AF8A40-5F44-445A-AD99-CECE00593601")
    endif()
    set(CPACK_PACKAGE_INSTALL_DIRECTORY "${CPACK_PACKAGE_NAME}")
endif()

string(REPLACE "." ";" OPENNOW_MSI_VERSION_PARTS "${CPACK_PACKAGE_VERSION}")
list(GET OPENNOW_MSI_VERSION_PARTS 0 CPACK_PACKAGE_VERSION_MAJOR)
list(GET OPENNOW_MSI_VERSION_PARTS 1 CPACK_PACKAGE_VERSION_MINOR)
list(GET OPENNOW_MSI_VERSION_PARTS 2 CPACK_PACKAGE_VERSION_PATCH)
if(CPACK_PACKAGE_VERSION_MAJOR GREATER 255 OR CPACK_PACKAGE_VERSION_MINOR GREATER 255
        OR CPACK_PACKAGE_VERSION_PATCH GREATER 65535)
    message(FATAL_ERROR "MSI version must fit 255.255.65535")
endif()

set(CPACK_PACKAGE_EXECUTABLES "OpenNOW" "${CPACK_PACKAGE_NAME}")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_CURRENT_BINARY_DIR}/OpenNOW-License.txt")
configure_file("${CMAKE_CURRENT_LIST_DIR}/../../LICENSE" "${CPACK_RESOURCE_FILE_LICENSE}" COPYONLY)
