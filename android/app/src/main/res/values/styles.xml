<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Styles only the pre-Compose window: the launch background and system bar tinting. Everything
      the user actually sees is drawn by OpenNowTheme in ui/theme/. Colours reference colors.xml
      rather than repeating hex that also lives in OpenNowPalette.
    -->
    <style name="OpenNowWindowBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <!--
          Keep the window itself transparent from creation so FLAG_SHOW_WALLPAPER can reveal the
          system wallpaper service, including live/motion wallpapers. Compose paints the normal
          opaque app background whenever that option is not selected and while streaming.
        -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:colorAccent">@color/opennow_accent</item>
    </style>

    <!--
      Only the font differs by API level: a font resource can be referenced from a theme from API 26
      onwards, so values-v26 points this at the bundled Inter and the launch window matches Compose.
      Everything else stays in OpenNowWindowBase so the two variants cannot drift.
    -->
    <style name="Theme.OpenNOW" parent="OpenNowWindowBase">
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
